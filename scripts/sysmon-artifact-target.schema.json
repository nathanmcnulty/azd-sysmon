{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "environmentName",
    "tenantId",
    "subscriptionId",
    "graphAccount",
    "mdeAccount",
    "paths",
    "artifactHashes"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "environmentName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}(?![\\s\\S])"
    },
    "tenantId": {
      "$ref": "#/$defs/guid"
    },
    "subscriptionId": {
      "$ref": "#/$defs/guid"
    },
    "graphAccount": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 254,
      "pattern": "^[^\\s@]+@[^\\s@]+(?![\\s\\S])"
    },
    "mdeAccount": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 254,
      "pattern": "^[^\\s@]+@[^\\s@]+(?![\\s\\S])"
    },
    "paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "package",
          "intune",
          "azureVm",
          "sentinel",
          "liveResponse"
        ]
      }
    },
    "artifactHashes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "azd-sysmon-state.json": {
          "$ref": "#/$defs/hash"
        },
        "azd-sysmon-intune-state.json": {
          "$ref": "#/$defs/hash"
        },
        "azd-sysmon-ama-application-state.json": {
          "$ref": "#/$defs/hash"
        },
        "azd-sysmon-live-response-state.json": {
          "$ref": "#/$defs/hash"
        }
      }
    }
  },
  "$defs": {
    "guid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
    },
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    }
  }
}
